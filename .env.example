# Server Port & Mode
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb://localhost:27017/employix

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=['https://yourdomain.com']

# Rate Limiting
RATE_LIMIT_MAX=100

# Nodemailer / SMTP Email Config
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Setu Production / Sandbox Credentials
SETU_BASE_URL=https://dg.setu.co
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id

# Surepass DigiLocker Integration
SUREPASS_BASE_URL=https://kyc-api.surepass.io
SUREPASS_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Psr80KSn4YLJr-yv6fuBpkcCYcMfFovOuxZXI7ZU4Dc

