# ==============================================================
# Employix Backend - Files To NOT Push To Server / Git
# ==============================================================

# 1. Dependencies (Always install fresh on server with `npm install`)
node_modules/
package-lock.json.backup

# 2. Local Environment Credentials & Secrets (NEVER PUSH - SENSITIVE)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert
*.crt

# 3. User Uploaded Documents & Media (Do not push real user KYC/files to git)
src/uploads/documents/*
!src/uploads/documents/.gitkeep
src/uploads/profile-images/*
!src/uploads/profile-images/.gitkeep
src/uploads/*
!src/uploads/.gitkeep
uploads/
temp/
tmp/

# 4. Logs & Diagnostics (Local logs should not go to server)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Local Database / Dumps / Seeds
data/
dump/
*.sqlite
*.db

# 6. Build & Test Artifacts
dist/
build/
coverage/
.nyc_output/

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. IDE & Local Editor Configurations
.vscode/
.idea/
*.sublime-*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
